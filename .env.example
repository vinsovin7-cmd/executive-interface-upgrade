# Copy to .env.local and fill in your own values.
# Never commit real secrets to GitHub. .env* files are gitignored in this repo.

# Supabase (required for auth, sessions, and all protected API routes)
# The URL must match tporrxnxwulannugtglq.supabase.co (enforced by lib/supabase/project.ts)
NEXT_PUBLIC_SUPABASE_URL=https://tporrxnxwulannugtglq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://tporrxnxwulannugtglq.supabase.co
# Service-role key. Either name is accepted (SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=your-service-role-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# OAuth redirect used by sign-in / sign-up (optional; falls back to window.location.origin/auth/callback)
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=https://your-app.vercel.app/auth/callback

# Telegram Mini App linking (TELEGRAM_BOT_TOKEN required, otherwise linking returns 503)
TELEGRAM_BOT_TOKEN=your-bot-token

# AdsGram rewards (optional)
NEXT_PUBLIC_ADSGRAM_BLOCK_ID=your-block-id
ADSGRAM_CALLBACK_SECRET=your-callback-secret

# TON telemetry + real on-chain payouts (optional read-only telemetry; payouts need all of the below)
TONCENTER_API_KEY=your-toncenter-api-key
# Server-side treasury wallet that signs payouts (server-only; never exposed to browser)
MASTER_TREASURY_ADDRESS=your-treasury-wallet-address
# Public treasury address for client-side sendTransaction recipient (safe to expose)
NEXT_PUBLIC_TREASURY_ADDRESS=your-treasury-wallet-address
GRAM_TOKEN_MASTER_ADDRESS=your-gram-master-address
# Optional: only needed if you also pay out USDT jettons
USDT_TOKEN_MASTER_ADDRESS=your-usdt-master-address
# Mnemonic of the wallet that holds GRAM/TON liquidity for payouts. It must control
# MASTER_TREASURY_ADDRESS above (server-only; never exposed to the browser).
TON_TREASURY_SIGNER_MNEMONIC=word1 word2 ... word24
# Strict TON gas ceiling for GRAM/USDT jetton transfers and TON payout gas.
# Only 0.001, 0.002, or 0.003 is accepted; anything else falls back to 0.003.
# Payouts abort if the treasury can't cover the transfer + this capped gas.
TON_JETTON_GAS_TON=0.003

# Owner vault (optional)
OWNER_VAULT_PIN=your-vault-pin